generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Client {
  id        String     @id @default(cuid())
  firstName String     @default("")
  lastName  String     @default("")
  name      String // "Name on Invoice" — defaults to "firstName lastName", editable
  email     String?
  phone     String?
  street    String?
  unit      String?
  city      String?
  state     String?
  zip       String?
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts Contract[]
}

model Contract {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token         String    @unique @default(cuid())
  docNumber     String    @unique

  serviceType   String
  frequency     String
  startDate     String
  rate          String
  serviceAddress String

  billingContact String?
  billingEmail   String?
  billingPhone   String?

  content       String    @db.Text // editable agreement clauses (plain text)

  status        String    @default("SENT") // SENT | SIGNED | VOID
  signerName    String?
  signedAt      DateTime?
  signedIp      String?

  sentAt        DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
}
